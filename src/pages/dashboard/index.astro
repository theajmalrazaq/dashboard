---
import PageLayout from "../../layouts/PageLayout.astro";
import { dashboardEnabled } from "../../lib/dashboardMode";
import DashboardHome from "../../components/dashboard/DashboardHome.jsx";

if (!dashboardEnabled) {
    return Astro.redirect("/");
}
---

<PageLayout
    title="Dashboard | Admin"
    description="Manage your portfolio blog posts and content."
    page="dashboard"
    hideFooter={true}
>
    <DashboardHome client:load />
</PageLayout>
