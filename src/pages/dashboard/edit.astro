---
import PageLayout from "../../layouts/PageLayout.astro";
import { dashboardEnabled } from "../../lib/dashboardMode";
import PostEditorWrapper from "../../components/dashboard/PostEditorWrapper.jsx";

if (!dashboardEnabled) {
    return Astro.redirect("/");
}
---

<PageLayout
    title="Edit Post | Dashboard"
    description="Update your existing content."
    page="dashboard"
    hideFooter={true}
>
    <PostEditorWrapper client:load />
</PageLayout>
