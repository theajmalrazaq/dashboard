---
import PageLayout from "../../layouts/PageLayout.astro";
import { dashboardEnabled } from "../../lib/dashboardMode";
import PostEditor from "../../components/dashboard/PostEditor.jsx";

if (!dashboardEnabled) {
    return Astro.redirect("/");
}
---

<PageLayout
    title="Create New Post | Dashboard"
    description="Draft a new blog post for your portfolio."
    page="dashboard"
    hideFooter={true}
>
    <PostEditor client:load />
</PageLayout>
